# Variables de entorno del sitio de la Fundación Nuestra Esperanza.
# Copiar este archivo como `.env.local` y completar los valores reales.
# NUNCA versionar `.env.local` ni escribir credenciales en el código.

# --- Notificaciones por correo del formulario de voluntariado (Fase 4) ---

# Servidor SMTP del proveedor de correo (ej. smtp.gmail.com)
SMTP_HOST=

# Puerto del servidor SMTP (ej. 587 para STARTTLS, 465 para SSL)
SMTP_PORT=

# Usuario de la cuenta SMTP (normalmente el correo remitente)
SMTP_USER=

# Contraseña o contraseña de aplicación de la cuenta SMTP
SMTP_PASS=

# Correo de la fundación que recibirá las solicitudes de voluntariado
CORREO_FUNDACION=
